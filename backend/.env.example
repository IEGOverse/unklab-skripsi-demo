# Konfigurasi Server
PORT=5000

# Gemini API Key (free tier, tanpa kartu kredit)
# 1. Buka https://aistudio.google.com/apikey
# 2. Buat API key, lalu isi di bawah ini.
GEMINI_API_KEY=your_gemini_api_key_here
# Model gratis (bisa dicek ketersediaannya di Google AI Studio)
GEMINI_MODEL=gemini-3.5-flash

# URL Frontend (untuk CORS). Kosongkan/ikuti default di server.js untuk mengizinkan semua origin (demo).
FRONTEND_URL=http://localhost:5173

# JSON Server database path
DB_PATH=./db.json
